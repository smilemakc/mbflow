{
  "description": "Sub-workflow fan-out: pick countries, run a child workflow for each in parallel, collect results.",
  "children": {
    "card": {
      "name": "FT04 child: country card",
      "nodes": [
        {
          "id": "card",
          "name": "Build card",
          "type": "transform",
          "config": {
            "type": "jq",
            "filter": "{name: .item.name.common, capital: (.item.capital // [] | first // \"-\"), population_band: (if (.item.area // 0) > 1000000 then \"large\" else \"regular\" end), position: .index}"
          }
        }
      ],
      "edges": []
    }
  },
  "workflow": {
    "name": "FT04 sub-workflow for_each",
    "nodes": [
      {
        "id": "fetch",
        "name": "Fetch countries",
        "type": "http",
        "config": {
          "method": "GET",
          "url": "https://raw.githubusercontent.com/mledoze/countries/master/countries.json"
        }
      },
      {
        "id": "pick",
        "name": "Pick countries",
        "type": "transform",
        "config": {
          "type": "jq",
          "filter": "{items: [.body[] | select(.subregion == \"{{input.subregion}}\")] | sort_by(.name.common) | .[:{{input.limit}}]}"
        }
      },
      {
        "id": "cards",
        "name": "Card per country",
        "type": "sub_workflow",
        "config": {
          "workflow_id": "${child:card}",
          "for_each": "input.items",
          "max_parallelism": 3
        }
      },
      {
        "id": "collect",
        "name": "Collect",
        "type": "transform",
        "config": {
          "type": "jq",
          "filter": "{total: .summary.total, cards: [.items[].output]}"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "fetch",
        "to": "pick"
      },
      {
        "id": "e2",
        "from": "pick",
        "to": "cards"
      },
      {
        "id": "e3",
        "from": "cards",
        "to": "collect"
      }
    ]
  },
  "cases": [
    {
      "name": "Nordic countries",
      "input": {
        "subregion": "Northern Europe",
        "limit": 4
      },
      "expect": {
        "output": [
          {
            "path": "total",
            "op": "eq",
            "value": 4
          },
          {
            "path": "cards",
            "op": "len",
            "value": 4
          },
          {
            "path": "cards.0.name",
            "op": "eq",
            "value": "Denmark"
          }
        ]
      }
    }
  ]
}
